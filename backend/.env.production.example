# ARTESA — Plantilla .env producción
# cp .env.production.example .env  → luego rellenar los <...>
# Generar JWT:       node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Generar INTERNAL:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NODE_ENV=production
PORT=3000
TZ=America/Bogota

DB_HOST=<RDS_PROD_ENDPOINT>
DB_PORT=5432
DB_NAME=artesa_produccion
DB_USER=artesa_admin
DB_PASSWORD=<ver prod-recursos.txt>
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

JWT_SECRET=<GENERAR>
JWT_REFRESH_SECRET=<GENERAR>
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# ⚠ Empresa PRODUCTIVA — distinta de staging
SAP_URL=https://vm-hbt-hm53.heinsohncloud.com.co:50000/b1s/v2
SAP_COMPANY=HBT_ARTESA
SAP_USER=manager_artesa
SAP_PASSWORD=Art3s4$$$$
SAP_SESSION_TIMEOUT=30
SAP_TIMEOUT=30000
SAP_RETRY_ATTEMPTS=3

SYNC_ENABLED=true
SYNC_CRON_SCHEDULE=0 0 * * *

SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<SMTP_USER_DE_STAGING>
SMTP_PASS=<SMTP_PASS_DE_STAGING>
SMTP_FROM=noreply@<DOMINIO>
APP_URL=https://<DOMINIO>

CORS_ORIGIN=https://<DOMINIO>
CORS_CREDENTIALS=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

LOG_LEVEL=info
INTERNAL_TOKEN=<GENERAR>
